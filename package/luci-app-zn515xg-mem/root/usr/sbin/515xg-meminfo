#!/bin/sh
#
# ZNXT ZN515XG-D - boot-time memory carve-out report.
#
# Called by the LuCI page view/zn515xg/mem.js through rpcd's file.exec and
# emits key=value lines on stdout:
#
#   phys_kb        total physical DRAM, as the kernel saw it at boot
#   mem_total_kb   MemTotal from /proc/meminfo
#   mem_free_kb    MemFree
#   mem_avail_kb   MemAvailable
#   resv_kb        the "reserved" figure of the boot "Memory:" line
#   src            dmesg | fallback   (where phys_kb/resv_kb came from)
#   resv_n         number of device-tree reserved-memory regions found
#   r<N>_name      region label from the device tree (atf, npu-binary, ...)
#   r<N>_addr      start address, 0x...
#   r<N>_end       end address (inclusive), 0x...
#   r<N>_kib       size in KiB
#   pool_kb        sum of the qdma*-buf regions (0 when none are reserved)
#   pool_mode      static  - pools are carved out by the device tree
#                  dynamic - no qdma region, the driver allocates on probe
#
# Why a helper and not plain file reads: the numbers the page needs come from
# three different places (/proc/meminfo, the boot "Memory:" line and the
# device-tree reserved-memory dump), and the reserved-memory regions carry
# their name and size only in the kernel log.  One exec also keeps the page at
# a single rpcd round trip per refresh.
#
# Nothing here is hardcoded to a DRAM size on purpose: the same firmware runs
# on the 512 MiB and the 1 GiB variant of this board, so every value is read at
# runtime.

MEMINFO=/proc/meminfo

mem_total=$(awk '/^MemTotal:/{print $2}' "$MEMINFO" 2>/dev/null)
mem_free=$(awk '/^MemFree:/{print $2}' "$MEMINFO" 2>/dev/null)
mem_avail=$(awk '/^MemAvailable:/{print $2}' "$MEMINFO" 2>/dev/null)

phys=0
resv=0
src=fallback

# The boot line is the only place that states the physical size directly:
#   [0.18] Memory: 427588K/524288K available (... 93140K reserved, 0K cma-reserved)
# 524288K is DRAM, 93140K is what the kernel carved out before the page
# allocator came up.
line=$(dmesg 2>/dev/null | grep -m1 'Memory: ')
if [ -n "$line" ]; then
	p=$(printf '%s\n' "$line" | sed -n 's/.*: *[0-9]*K\/\([0-9]*\)K available.*/\1/p')
	r=$(printf '%s\n' "$line" | sed -n 's/.*, *\([0-9]*\)K reserved.*/\1/p')
	if [ -n "$p" ]; then
		phys=$p
		resv=${r:-0}
		src=dmesg
	fi
fi

# Fallback (log has rotated past the boot lines): assume DRAM == MemTotal and
# mark the source so the page can say the figure is approximate.
if [ "$src" = fallback ]; then
	phys=${mem_total:-0}
	resv=0
fi

echo "phys_kb=$phys"
echo "mem_total_kb=${mem_total:-0}"
echo "mem_free_kb=${mem_free:-0}"
echo "mem_avail_kb=${mem_avail:-0}"
echo "resv_kb=$resv"
echo "src=$src"

# Device-tree carve-outs, one line each in the kernel log:
#   OF: reserved mem: 0x...87000000..0x...88ffffff (32768 KiB) nomap
#   non-reusable qdma0-buf@87000000
TMP=/tmp/.515xg-meminfo.$$
dmesg 2>/dev/null |
	sed -n 's/.*reserved mem: \(0x[0-9a-f]*\)\.\.\(0x[0-9a-f]*\) (\([0-9]*\) KiB).* \([^ ]*\)@[0-9a-f][0-9a-f]*$/\1 \2 \3 \4/p' \
	> "$TMP" 2>/dev/null

n=0
pool=0
while read -r addr end kib name; do
	[ -n "$name" ] || continue
	echo "r${n}_name=$name"
	echo "r${n}_addr=$addr"
	echo "r${n}_end=$end"
	echo "r${n}_kib=$kib"
	case "$name" in
		qdma*-buf) pool=$((pool + kib)) ;;
	esac
	n=$((n + 1))
done < "$TMP"

rm -f "$TMP"

echo "resv_n=$n"
echo "pool_kb=$pool"
if [ "$pool" -gt 0 ]; then
	echo "pool_mode=static"
elif [ "$n" -gt 0 ]; then
	echo "pool_mode=dynamic"
else
	echo "pool_mode=unknown"
fi

exit 0
