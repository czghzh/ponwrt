. /lib/functions/uci-defaults.sh

board_config_update

# Default Wi-Fi regulatory domain for the ZNXT boxes.
# wifi-detect / mac80211.uc read this from /etc/board.json (wlan.defaults.country)
# when generating /etc/config/wireless.
case "$(board_name)" in
znxt,zn504xg-d|znxt,zn515xg-d)
	ucidef_set_country CN
	;;
esac

board_config_flush

exit 0
